{% extends 'base.html.twig' %}

{% block title %}Hello ContactController!{% endblock %}

{% block body %}

<main>
    <h1>Contacts</h1>

    <p>Expand the "New Contact" section to add contacts.</p>

    <hr>

    {# New Contact #}
    <section>
        <details
            name="new-contact"
            {{ form.vars.submitted and not form.vars.valid ? 'open' }}
        >
            <summary>
                <h2>New Contact</h2>
            </summary>

            {{ form(form) }}
        </details>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message|raw }}
            </div>
        {% endfor %}
    </section>

    {# Existing Contacts #}
    <section x-data="{
        open: false,
        name: '',
        url: '',
        target: '',
        confirmDelete() {
            htmx.ajax('DELETE', this.url, { target: this.target, swap: 'outerHTML' });
            this.open = false;
        }
    }">
        <details name="contacts" open>
            <summary>
                <h2>Existing Contacts</h2>
            </summary>

            {% if contacts is empty %}
                <p>No contacts found.</p>
            {% else %}
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Surname</th>
                            <th>Phone Number</th>
                            <th>Email</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for contact in contacts %}
                            <tr id="contact-row-{{ contact.id }}">
                                <td>{{ contact.name }}</td>
                                <td>{{ contact.surname }}</td>
                                <td>{{ contact.phoneNumber }}</td>
                                <td>{{ contact.email }}</td>
                                <td>
                                    <button
                                        type="button"
                                        @click="
                                            name = '{{ contact.name|e('js') }}';
                                            url = '{{ path('app_contact_delete', {id: contact.id}) }}';
                                            target = '#contact-row-{{ contact.id }}';
                                            open = true;
                                        "
                                    >
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </details>

        <dialog
            x-effect="open ? $el.showModal() : $el.close()"
            @close="open = false"
            @keydown.escape.window="open = false"
        >
            <article>
                <header>
                    <h3>Confirm Deletion</h3>
                </header>

                <p>Are you sure you want to delete <strong x-text="name"></strong>?</p>

                <footer>
                    <menu>
                        <button type="button" @click="open = false">Cancel</button>
                        <button type="button" @click="confirmDelete()">Confirm Delete</button>
                    </menu>
                </footer>
            </article>
        </dialog>
    </section>
</main>
{% endblock %}
