<h1>New Contact Form Submission</h1>

<p>A new contact entry was created on the website.</p>

<table border="1" cellpadding="8" cellspacing="0">
    <tr>
        <th>Name</th>
        <td>{{ contact.name }}</td>
    </tr>
    <tr>
        <th>Name</th>
        <td>{{ contact.surname }}</td>
    </tr>
    <tr>
        <th>Phone Number</th>
        <td>{{ contact.phoneNumber }}</a></td>
    </tr>
    <tr>
        <th>Email</th>
        <td><a href="mailto:{{ contact.email }}">{{ contact.email }}</a></td>
    </tr>
</table>
